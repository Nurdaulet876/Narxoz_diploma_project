BASE_URL=http://localhost
TOKEN=your_department_scoped_token
# Department sub-account ID in Canvas (use 1 for local root account)
SUB_ACCOUNT_ID=1
# Optional: filter by specific semester/term ID (leave empty for all active terms)
TERM_ID=
# Optional: mask student names and hash student IDs for production privacy (true/false)
ANONYMIZE_PII=false
HASH_SALT=change_me_to_random_secret
OUTPUT_FILE=canvas_api_export.csv